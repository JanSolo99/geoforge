#!/usr/bin/env python3
"""Manage a running `./scripts/agents --daemon` from any shell (for example over SSH/Tailscale).

    agents-remote                   the chat prompt (same as `chat`)
    agents-remote chat              a prompt like ./scripts/agents, attached to the daemon
    agents-remote status            what the coordinator is doing
    agents-remote start | stop      start the daemon (systemd unit if installed) / stop it after this turn
    agents-remote pause | resume    hold / release new tasks (the turn in progress finishes)
    agents-remote submit TEXT...    queue a task (runs after the ones already queued)
    agents-remote cmd /switch codex queue a coordinator command (/switch, /auto, /new, /session)
    agents-remote queue | clear     show queued items / drop them
    agents-remote log [N] | follow  last N lines of the daemon log (default 40) / follow it
    agents-remote cli [AGENT]       stop the daemon, open the native CLI here, start it again
    agents-remote web [PORT] [HOST] status page + progress dashboard (HOST `tailscale` = tailnet IP)
    agents-remote lanes             every coordinator: the main one and the parallel lanes

`--lane NAME` (or `-l NAME`) before a command targets a parallel lane (scripts/lane) instead of the
main coordinator, for example `agents-remote -l kimi start` or `agents-remote -l codex chat`.
"""
import datetime as dt
import json
import re
from pathlib import Path
import shlex
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, urlsplit

ROOT = Path(__file__).resolve().parents[1]
common = Path(subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--git-common-dir"],
                             capture_output=True, text=True, check=True).stdout.strip())
COORD = (ROOT / common).resolve() / "agent-coordinator"
REMOTE = COORD / "remote"
INBOX, DONE = REMOTE / "inbox", REMOTE / "done"
UNIT = "unigis-agents"
LANE = None


def use(lane):
    """Point every command at a parallel lane's coordinator (None: the main one)."""
    global REMOTE, INBOX, DONE, LANE
    if lane and not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,30}", lane):
        raise SystemExit(f"bad lane name {lane!r}")
    LANE = lane or None
    REMOTE = (COORD / "lanes" / lane if lane else COORD) / "remote"
    INBOX, DONE = REMOTE / "inbox", REMOTE / "done"


def lane_names():
    return sorted(p.parent.name for p in (COORD / "lanes").glob("*/state.json"))
AGENTS = ("claude", "codex", "kimi")


def ensure():
    for d in (INBOX, DONE):
        d.mkdir(parents=True, exist_ok=True)


def enqueue(kind, text):
    ensure()
    name = f"{time.time_ns()}.{kind}"
    tmp = INBOX / f".{name}.tmp"
    tmp.write_text(text.strip() + "\n")
    tmp.rename(INBOX / name)  # only complete files are ever visible to the daemon
    return name


def status():
    path = REMOTE / "status.json"
    if not path.exists():
        return {"state": "never started"}
    return json.loads(path.read_text())


def running(s=None):
    """True while a daemon process is alive (status.json alone can be stale after a crash)."""
    pid = (s or status()).get("pid")
    try:
        return bool(pid) and b"--daemon" in Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False


def ago(iso):
    if not iso:
        return ""
    seconds = int((dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(iso)).total_seconds())
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m" if seconds >= 3600 else f"{seconds // 60}m{seconds % 60:02d}s"


def local(iso):
    return dt.datetime.fromisoformat(iso).astimezone().strftime("%a %H:%M") if iso else ""


def summary():
    """A few readable lines: daemon state, agent, current task, limits, queue."""
    s = status()
    alive = running(s)
    state = s.get("state", "?") if alive else "not running"
    if alive and (REMOTE / "PAUSE").exists():
        state += " (paused: new tasks wait)"
    lines = [f"daemon:  {state}", f"agent:   {s.get('agent', '?')}"]
    if alive and s.get("state") == "running":
        lines.append(f"task:    {s.get('task', '')[:120]} ({ago(s.get('started'))})")
    if alive and s.get("state") == "backoff":
        lines.append(f"retry:   {local(s.get('until'))}")
    current = dt.datetime.now(dt.timezone.utc)
    for agent, until in (s.get("limited_until") or {}).items():
        if dt.datetime.fromisoformat(until) > current:
            lines.append(f"limit:   {agent} until {local(until)}")
    last = s.get("last_run") or {}
    if last:
        lines.append(f"last:    {last.get('agent')} {last.get('status')} {local(last.get('finished'))}")
    waiting = queue()[0]
    if waiting:
        lines.append(f"queued:  {len(waiting)}" + ("" if alive else "  (they run once the daemon starts)"))
    return "\n".join(lines)


def queue():
    ensure()
    waiting = sorted(p for p in INBOX.iterdir() if not p.name.startswith("."))
    finished = sorted(DONE.iterdir())[-10:]
    return waiting, finished


def describe(path):
    when = dt.datetime.fromtimestamp(int(path.name.split(".")[0]) / 1e9).strftime("%a %H:%M")
    text = path.read_text(errors="replace").strip().replace("\n", " ") if path.is_file() else ""
    return f"{when}  {path.name.split('.', 1)[1]:<14} {text[:90]}"


def show_queue():
    waiting, finished = queue()
    print("waiting:" if waiting else "waiting: (none)", *map(describe, waiting), sep="\n  ")
    print("finished:", *map(describe, finished), sep="\n  ")


def clear():
    waiting, _ = queue()
    for path in waiting:
        path.unlink(missing_ok=True)
    return len(waiting)


def tail(n):
    path = REMOTE / "daemon.log"
    return "".join(path.read_text(errors="replace").splitlines(keepends=True)[-n:]) if path.exists() else ""


def has_unit():
    return subprocess.run(["systemctl", "--user", "cat", UNIT], capture_output=True).returncode == 0


def start():
    if running():
        return "already running"
    (REMOTE / "STOP").unlink(missing_ok=True)
    if LANE:
        # A transient user service: it survives logout (linger) but not a reboot.
        unit = f"unigis-lane-{LANE}"
        subprocess.run(["systemctl", "--user", "reset-failed", unit], capture_output=True)
        subprocess.run(["systemd-run", "--user", f"--unit={unit}", "--collect", "--quiet",
                        f"--working-directory={ROOT}", f"--setenv=PATH={Path.home()}/.local/bin:"
                        f"{Path.home()}/.cargo/bin:/usr/local/bin:/usr/bin:/bin",
                        sys.executable, str(ROOT / "scripts/agents"), "--daemon", "--lane", LANE],
                       check=True)
        return f"started lane {LANE} ({unit}.service)"
    if has_unit():
        subprocess.run(["systemctl", "--user", "start", UNIT], check=True)
        return f"started ({UNIT}.service)"
    subprocess.Popen([str(ROOT / "scripts/agents"), "--daemon"], cwd=ROOT, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return "started"


def stop():
    if not running():
        return "not running"
    ensure()
    (REMOTE / "STOP").write_text("")
    return "stop requested; it exits after the current turn"


def wait_stopped():
    """Wait for the daemon to exit. False if the user gave up (the stop request stays)."""
    print("Waiting for the current turn to finish (Ctrl-C gives up)…", flush=True)
    try:
        while running():
            time.sleep(2)
        return True
    except KeyboardInterrupt:
        print()
        return False


def cli(agent=""):
    """Hand the terminal to the native CLI on the coordinator's session, then restart the daemon."""
    was_running = running()
    if was_running:
        stop()
        if not wait_stopped():
            return
    lane = ["--lane", LANE] if LANE else []
    subprocess.call([str(ROOT / "scripts/agents"), *lane, "--cli", *([agent] if agent else [])], cwd=ROOT)
    if was_running:
        print("daemon", start())


# Commands the daemon itself runs, with the argument shapes it accepts.
def valid_daemon_command(parts):
    command, args = parts[0], parts[1:]
    return ((command == "/switch" and len(args) == 1 and args[0] in AGENTS)
            or (command == "/auto" and args in (["on"], ["off"]))
            or (command == "/new" and len(args) <= 1 and (not args or args[0] in AGENTS))
            or (command == "/session" and len(args) == 2 and args[0] in AGENTS))


CHAT_HELP = """A line queues a task for the agent. Commands:
  /status /queue /log [N] /handoff      look around
  /start /stop /pause /resume /clear    control the daemon and its queue
  /switch claude|codex|kimi  /new [AGENT]  /auto on|off  /session AGENT UUID   sent to the daemon
  /cli [AGENT]   stop the daemon, open the native CLI here, restart the daemon after
  /quit          leave the prompt (the daemon keeps running)"""


def chat():
    """A prompt attached to the daemon: lines become tasks, /commands are handled or forwarded."""
    import threading
    ensure()
    log = REMOTE / "daemon.log"
    stop_event = threading.Event()
    position = [log.stat().st_size if log.exists() else 0]

    def pump():
        while not stop_event.is_set():
            if log.exists() and log.stat().st_size > position[0]:
                with log.open(errors="replace") as f:
                    f.seek(position[0])
                    sys.stdout.write(f.read())
                    sys.stdout.flush()
                    position[0] = f.tell()
            time.sleep(1)

    print(summary())
    if not running():
        print("\nThe daemon is not running: queued tasks wait until /start.")
    print("\n" + CHAT_HELP)
    pumper = threading.Thread(target=pump, daemon=True)
    pumper.start()
    try:
        while True:
            try:
                line = input("remote> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not line:
                continue
            if not line.startswith("/"):
                print(f"queued ({len(queue()[0]) + 1} waiting)", "" if running() else
                      "— daemon not running, /start to run it")
                enqueue("task", line)
                continue
            try:
                parts = shlex.split(line)
            except ValueError as error:
                print(error)
                continue
            command, args = parts[0], parts[1:]
            if command == "/quit":
                break
            elif command in ("/help", "/?"):
                print(CHAT_HELP)
            elif command == "/status":
                print(summary())
            elif command == "/queue":
                show_queue()
            elif command == "/log":
                print(tail(int(args[0]) if args and args[0].isdigit() else 40), end="")
            elif command == "/handoff":
                print((ROOT / "docs/HANDOFF.md").read_text())
            elif command == "/start":
                print(start())
            elif command == "/stop":
                print(stop())
            elif command == "/pause":
                (REMOTE / "PAUSE").write_text("")
                print("paused: the current turn finishes, new tasks wait")
            elif command == "/resume":
                (REMOTE / "PAUSE").unlink(missing_ok=True)
                print("resumed")
            elif command == "/clear":
                print(f"dropped {clear()} queued item(s)")
            elif command == "/cli" and len(args) <= 1 and (not args or args[0] in AGENTS):
                stop_event.set()
                pumper.join()
                cli(*args)
                position[0] = log.stat().st_size if log.exists() else 0
                stop_event.clear()
                pumper = threading.Thread(target=pump, daemon=True)
                pumper.start()
            elif valid_daemon_command(parts):
                enqueue("cmd", line)
                print("sent" if running() else "queued — daemon not running, /start to apply it")
            else:
                print("Unknown command or arguments; /help lists them.")
    finally:
        stop_event.set()


def coordinator_state():
    path = REMOTE.parent / "state.json"
    return json.loads(path.read_text()) if path.exists() else {}


def clip(text, n=160):
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:n - 1] + "…"


def steps(log_dir, limit=12):
    """The latest readable steps of a run, from the tail of its events.jsonl."""
    path = Path(log_dir) / "events.jsonl"
    if not path.exists():
        return []
    with path.open("rb") as f:
        f.seek(max(0, path.stat().st_size - 400_000))
        raw = f.read().decode("utf-8", errors="replace").splitlines()[1:]
    out = []
    for line in raw:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        kind = event.get("type")
        if kind == "assistant" and not event.get("parent_tool_use_id"):
            for block in event.get("message", {}).get("content", []):
                if block.get("type") == "text" and block.get("text", "").strip():
                    out.append(("say", clip(block["text"])))
                elif block.get("type") == "tool_use":
                    args = block.get("input", {})
                    detail = (args.get("description") or args.get("command") or args.get("file_path")
                              or args.get("pattern") or args.get("prompt") or "")
                    out.append(("tool", clip(f"{block.get('name')}: {detail}")))
        elif kind == "item.started" and event.get("item", {}).get("type") == "command_execution":
            command = event["item"].get("command", "")
            command = command.split(" -lc ", 1)[-1].strip("'\"")
            out.append(("tool", clip("$ " + command)))
        elif kind == "item.completed" and event.get("item", {}).get("type") == "agent_message":
            out.append(("say", clip(event["item"].get("text", ""))))
    return out[-limit:]


def work_queue():
    """Next tools and overall progress from docs/WORK_QUEUE.md."""
    path = ROOT / "docs" / "WORK_QUEUE.md"
    if not path.exists():
        return {}
    text = path.read_text()
    upcoming = re.findall(r"^\| \d+ \| \[?([^\]|]+)\]?(?:\([^)]*\))? \| ([^|]+) \|", text, re.M)[:3]
    overall = re.search(r"Overall: (\d+) of (\d+)", text)
    return {"next": [f"{name} ({toolbox.strip()})" for name, toolbox in upcoming],
            "done": int(overall[1]) if overall else None, "total": int(overall[2]) if overall else None}


def lanes_overview():
    """One line per coordinator for the page's tabs."""
    rows = []
    for lane in [None, *lane_names()]:
        use(lane)
        d = live(brief=True)
        if lane is None and d["state"] == "stopped" and not d["steps"] and lane_names():
            continue
        rows.append({"lane": lane or "main", "state": d["state"], "agent": d["agent"] or d["preferred"],
                     "task": d["task"][:90], "claim": d.get("claim")})
    use(None)
    return rows


def lane_claim(lane):
    path = COORD / "claims.json"
    claims = json.loads(path.read_text()) if path.exists() else {}
    return ", ".join(c["title"] for c in claims.values() if c.get("lane") == lane) or None


def live(brief=False):
    """Everything the web page shows, as JSON."""
    s = status()
    alive = running(s)
    last = coordinator_state().get("last_run", {})
    working = alive and last.get("status") == "running"
    idle_for = None
    if working:
        events = Path(last["log"]) / "events.jsonl"
        stamp = events.stat().st_mtime if events.exists() else Path(last["log"]).stat().st_mtime
        idle_for = int(time.time() - stamp)
    if not alive:
        state = "stopped"
    elif working:
        state = "working"
    elif s.get("state") == "backoff":
        state = "waiting"
    else:
        state = "paused" if (REMOTE / "PAUSE").exists() else "idle"
    current = dt.datetime.now(dt.timezone.utc)
    waiting, finished = queue()
    return {
        "state": state, "paused": (REMOTE / "PAUSE").exists(),
        "preferred": s.get("agent") or coordinator_state().get("agent"), "agent": last.get("agent") if working else None,
        "task": s.get("task", "") if working else "", "started": s.get("started") if working else None,
        "idle_for": idle_for, "retry_at": s.get("until") if state == "waiting" else None,
        "limits": {a: t for a, t in (s.get("limited_until") or {}).items()
                   if dt.datetime.fromisoformat(t) > current},
        "last": {k: last.get(k) for k in ("agent", "status", "finished")} if not working else None,
        "steps": steps(last["log"], 1 if brief else 12) if last.get("log") else [],
        "lane": LANE, "claim": lane_claim(LANE) if LANE else None,
        "queue": [describe(p) for p in waiting], "finished": [describe(p) for p in finished[::-1][:5]],
        "log": tail(40), "work": work_queue(),
    }


