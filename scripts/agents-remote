const $=id=>document.getElementById(id);
const esc=t=>String(t??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const dur=s=>s<60?s+"s":s<3600?Math.floor(s/60)+"m":Math.floor(s/3600)+"h "+String(Math.floor(s%3600/60)).padStart(2,"0")+"m";
const since=iso=>dur(Math.max(0,Math.round((Date.now()-Date.parse(iso))/1000)));
const at=iso=>new Date(iso).toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"});
const L=new URLSearchParams(location.search).get("lane")||"";
const q=L?"?lane="+encodeURIComponent(L):"";
const btn=(action,text,label)=>`<form method=post action=${action}${q}><input type=hidden name=text value="${text}"><button>${label}</button></form>`;
document.querySelector("form[action='/submit']").action="/submit"+q;
async function tabs(){
  let rows; try{rows=await (await fetch("/api/lanes",{cache:"no-store"})).json()}catch(e){return}
  if(rows.length<2){$("tabs").innerHTML="";return}
  $("tabs").innerHTML=rows.map(r=>{const on=(r.lane==(L||"main"));const href=r.lane=="main"?"/":"/?lane="+r.lane;
    return `<a class="${r.state}${on?" on":""}" href="${href}" title="${esc(r.claim||r.task)}"><span class=dot></span>${esc(r.lane)} · ${esc(r.agent||"")}</a>`}).join("");
}
async function refresh(){
  tabs();
  let d; try{d=await (await fetch("/api/status"+q,{cache:"no-store"})).json()}
  catch(e){$("headline").textContent="Can't reach the machine";$("hero").className="card stopped";return}
  $("hero").className="card "+d.state;
  let head, detail=[];
  if(d.claim)detail.push(`claimed: ${esc(d.claim)}`);
  if(d.state=="working"){head=`${d.lane?d.lane+": ":""}${d.agent} is working`;detail.push(`on “${esc(d.task.slice(0,120))}” for ${since(d.started)}`);
    detail.push(d.idle_for>300?`<span class=warn>no output for ${dur(d.idle_for)} (long command or stuck?)</span>`:`last activity ${dur(d.idle_for)} ago`);}
  else if(d.state=="waiting"){head="Waiting to retry";detail.push("next try "+at(d.retry_at));}
  else if(d.state=="stopped"){head="Stopped";detail.push("the daemon is not running; press Start");}
  else if(d.state=="paused"){head="Paused";detail.push("new tasks wait until Resume");}
  else{head="Idle";detail.push("waiting for tasks");}
  if(d.last&&d.last.agent)detail.push(`last turn: ${d.last.agent} ${d.last.status} at ${at(d.last.finished)}`);
  for(const [a,t] of Object.entries(d.limits))detail.push(`${a} limited until ${at(t)}`);
  if(d.preferred&&d.agent&&d.preferred!=d.agent)detail.push(`preferred: ${d.preferred}`);
  $("headline").textContent=head;$("detail").innerHTML=detail.join(" · ");
  $("steps").innerHTML=d.steps.length?d.steps.slice().reverse().map(([k,t],i)=>`<li class="${k}${i==0&&d.state=="working"?" latest":""}">${esc(t)}</li>`).join(""):"<li class=empty>No steps yet</li>";
  $("queue").innerHTML=(d.queue.length?d.queue.map(q=>`<li>${esc(q)}</li>`).join(""):"<li class=empty>Nothing queued</li>")
    +(d.finished.length?`<li class=empty>Recently finished:</li>`+d.finished.map(q=>`<li class=empty>${esc(q)}</li>`).join(""):"");
  const others=["claude","codex","kimi"].filter(a=>a!=d.preferred);
  $("controls").innerHTML=(d.state=="stopped"?`<form method=post action=/start${q}><button class=primary>Start daemon</button></form>`:"")
    +btn("/cmd",d.paused?"/resume":"/pause",d.paused?"Resume":"Pause")+others.map(a=>btn("/cmd","/switch "+a,"Prefer "+a)).join("")
    +btn("/cmd","/new","Fresh session")+(d.queue.length?`<form method=post action=/clear${q}><button>Clear queue</button></form>`:"")
    +(d.state!="stopped"?`<form method=post action=/stop${q} onsubmit="return confirm('Stop the daemon after this turn?')"><button>Stop daemon</button></form>`:"");
  const w=d.work||{};$("work").innerHTML=(w.total?`<b>${w.done} of ${w.total}</b> ArcGIS tools done (${(100*w.done/w.total).toFixed(1)}%)<br>`:"")
    +(w.next&&w.next.length?"Next: "+w.next.map(esc).join(" → "):"No docs/WORK_QUEUE.md yet");
  const log=$("log");if(log.textContent!=d.log)log.textContent=d.log;
  $("updated").textContent="Updated "+new Date().toLocaleTimeString();
}
refresh();setInterval(refresh,4000);
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, body, code=200):
        data = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.split("?")[0] in ("/dashboard", "/dashboard.html"):
            page = ROOT / "docs" / "dashboard.html"
            # Rebuilt on every visit (well under a second) so it shows the latest commits and handoff.
            subprocess.run([sys.executable, str(ROOT / "scripts/dashboard/build.py")], cwd=ROOT,
                           capture_output=True, timeout=60)
            if page.exists():
                self.reply(page.read_text())
            else:
                self.reply("dashboard.html has not been built yet: python3 scripts/dashboard/build.py", 404)
            return
        url = urlsplit(self.path)
        if url.path in ("/api/status", "/api/lanes"):
            if url.path == "/api/lanes":
                data = json.dumps(lanes_overview()).encode()
            else:
                use((parse_qs(url.query).get("lane") or [None])[0])
                data = json.dumps(live()).encode()
                use(None)
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        self.reply(PAGE)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        form = parse_qs(self.rfile.read(length).decode())
        text = (form.get("text") or [""])[0].strip()
        url = urlsplit(self.path)
        lane = (parse_qs(url.query).get("lane") or [None])[0]
        use(lane)
        self.path = url.path
        if self.path == "/submit" and text:
            enqueue("task", text)
        elif self.path == "/cmd" and text == "/pause":
            ensure(); (REMOTE / "PAUSE").write_text("")
        elif self.path == "/cmd" and text == "/resume":
            (REMOTE / "PAUSE").unlink(missing_ok=True)
        elif self.path == "/cmd" and text and valid_daemon_command(text.split()):
            enqueue("cmd", text)
        elif self.path == "/start":
            start()
        elif self.path == "/stop":
            stop()
        elif self.path == "/clear":
            clear()
        use(None)
        self.send_response(303)
        self.send_header("Location", f"/?lane={lane}" if lane else "/")
        self.end_headers()


def main(argv):
    if argv[:1] in (["--lane"], ["-l"]) and len(argv) > 1:
        use(argv[1])
        argv = argv[2:]
    if not argv:
        if sys.stdin.isatty():
            chat()
        else:
            print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "status":
        print(summary())
    elif cmd == "log":
        print(tail(int(rest[0]) if rest else 40), end="")
    elif cmd == "follow":
        subprocess.call(["tail", "-n", "40", "-F", str(REMOTE / "daemon.log")])
    elif cmd == "submit" and rest:
        print("queued", enqueue("task", " ".join(rest)), "" if running() else "(daemon not running)")
    elif cmd == "cmd" and rest and valid_daemon_command(rest):
        print("queued", enqueue("cmd", " ".join(rest)))
    elif cmd == "queue":
        show_queue()
    elif cmd == "clear":
        print(f"dropped {clear()} queued item(s)")
    elif cmd == "pause":
        ensure(); (REMOTE / "PAUSE").write_text(""); print("paused")
    elif cmd == "resume":
        (REMOTE / "PAUSE").unlink(missing_ok=True); print("resumed")
    elif cmd == "start":
        print(start())
    elif cmd == "stop":
        print(stop())
    elif cmd == "cli" and len(rest) <= 1 and (not rest or rest[0] in AGENTS):
        cli(*rest)
    elif cmd == "chat":
        chat()
    elif cmd == "lanes":
        for row in lanes_overview():
            print(f"{row['lane']:8} {row['state']:9} {row['agent'] or '':7} "
                  f"{row['claim'] or row['task'] or ''}")
    elif cmd == "web":
        port = int(rest[0]) if rest else 8765
        host = rest[1] if len(rest) > 1 else "127.0.0.1"
        if host == "tailscale":  # listen on this machine's tailnet address only
            host = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True,
                                  check=True).stdout.split()[0]
        print(f"http://{host}:{port}  (localhost-only by default; `tailscale serve --bg {port}` adds HTTPS)")
        # One request at a time: `use` switches module-level paths per lane.
        HTTPServer((host, port), Handler).serve_forever()
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
