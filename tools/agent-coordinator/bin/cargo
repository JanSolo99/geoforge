#!/bin/sh
# Cargo for parallel lanes: at most UNIGIS_BUILD_SLOTS (default 2) builds run at once across all
# lanes, so three agents compiling together fit in memory. Quick commands skip the queue. The slot
# is an flock held by the cargo process itself, so it is released whenever cargo exits.
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$here" | paste -sd: -)
export PATH
case "$1" in
    fmt|metadata|locate-project|pkgid|tree|--version|-V|help|--help) exec cargo "$@" ;;
esac
dir="${XDG_RUNTIME_DIR:-/tmp}/unigis-build-slots"
mkdir -p "$dir"
slots=${UNIGIS_BUILD_SLOTS:-2}
waited=0
while :; do
    i=0
    while [ "$i" -lt "$slots" ]; do
        exec 9>"$dir/slot$i"
        if flock -n 9; then
            [ "$waited" = 1 ] && echo "cargo: got build slot $i" >&2
            exec cargo "$@"
        fi
        exec 9>&-
        i=$((i + 1))
    done
    [ "$waited" = 0 ] && echo "cargo: waiting for a build slot (other lanes are building)" >&2
    waited=1
    sleep 3
done
